{
  "name": "n8n-nodes-rckflr-centroid",
  "version": "1.1.0",
  "description": "Reliable n8n community node that computes the centroid of multidimensional vectors with validation and item-level processing.",
  "keywords": [
    "n8n",
    "n8n-community-node",
    "centroid",
    "vector",
    "math",
    "rckflr"
  ],
  "license": "MIT",
  "homepage": "https://github.com/MauricioPerera/n8n-nodes-rckflr-centroid",
  "author": {
    "name": "Mauricio Perera",
    "email": "support@centoide.dev",
    "url": "https://centoide.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MauricioPerera/n8n-nodes-rckflr-centroid.git"
  },
  "bugs": {
    "url": "https://github.com/MauricioPerera/n8n-nodes-rckflr-centroid/issues"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9.1"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier \"nodes/**/*.ts\" \"tests/**/*.ts\" \"*.{js,json}\" --write",
    "lint": "eslint nodes tests package.json",
    "lintfix": "eslint nodes tests package.json --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build && pnpm lint -c .eslintrc.prepublish.js nodes package.json && pnpm test"
  },
  "files": [
    "dist",
    "nodes",
    "credentials",
    "examples"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/Centroid/Centroid.node.js"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.15.0",
    "@vitest/coverage-v8": "^4.0.9",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
